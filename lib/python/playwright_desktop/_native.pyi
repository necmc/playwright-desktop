from ._models import InvokeParams

class NativeError(Exception): ...

def binding_version() -> str: ...
def os_language() -> str: ...

class Request:
    def cancel(self) -> None: ...

class Reply:
    @property
    def handle(self) -> int: ...
    @property
    def text(self) -> str | None: ...
    @property
    def pid(self) -> int | None: ...
    @property
    def title(self) -> str | None: ...

class Engine:
    def __init__(self) -> None: ...
    def open_session(self, java_home: str) -> int: ...
    def open_auto_session(self, java_home: str | None = None, *, explicit: bool = False) -> int: ...
    def new_request(self, session_id: int, timeout_ms: int) -> Request: ...
    def invoke(self, request: Request, params: InvokeParams) -> Reply: ...
    def close_session(self, session_id: int) -> None: ...
    def cancel_capture(self, session_id: int, capture_id: int) -> None: ...
